+    else:start=[config["python"]["path"],"-B",str(Path(config["code_root"])/"portable_run.py"),"run"]
+    return start+["--data-root",config["data_root"],"--work-root",config["work_root"],"--id",identity,
+                  "--checker",CHECKER,"--timeout",str(timeout),"--",*words]
+
